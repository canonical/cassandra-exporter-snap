#!/bin/bash
set -e

CONFIG_FILE="$SNAP_COMMON/config.yml"

# Copy default config on first run if not present
if [ ! -f "$CONFIG_FILE" ]; then
    cp "$SNAP/etc/default-config.yml" "$CONFIG_FILE"
fi

# Apply snap configuration into the config file. The upstream jar only reads
# the on-disk config, so snap options must be written into it (mirrors the
# upstream docker run.sh sed substitution) rather than passed via env vars.
apply_config() {
    local field="$1" value="$2"
    [ -n "$value" ] || return 0
    # Escape sed replacement metacharacters (\ / &) so arbitrary values are safe.
    local escaped
    escaped=$(printf '%s' "$value" | sed -e 's/[\/&]/\\&/g')
    sed -ri "s/^(${field}):.*/\1: ${escaped}/" "$CONFIG_FILE"
}

apply_config host "$(snapctl get cassandra.host)"
apply_config listenPort "$(snapctl get web.listen-port)"
apply_config user "$(snapctl get cassandra.user)"
apply_config password "$(snapctl get cassandra.password)"

exec "$SNAP/usr/lib/jvm/default-java/bin/java" -jar "$SNAP/jar/cassandra_exporter.jar" "$CONFIG_FILE"
